# Copia este archivo a .env (fuera de git) en el VPS y complétalo.

# Versión exacta de la imagen de n8n (no uses «latest» en producción). Los flujos se probaron con 2.48.5.
N8N_VERSION=2.48.5

# Dominio con HTTPS donde quedará n8n, sin https:// (p. ej. n8n.tu-dominio.pe).
N8N_DOMINIO=

# Cifra las credenciales guardadas en n8n. Genera una larga y aleatoria y guárdala en un lugar
# seguro: si se pierde, hay que volver a cargar todas las credenciales.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
