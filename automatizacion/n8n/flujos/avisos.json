{
  "name": "Copiloto · avisos por Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 5-22 * * *"
            }
          ]
        }
      },
      "id": "d32a5ea5-cdc8-5b28-af1e-0781e262c211",
      "name": "Cada 10 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "98091941-36ca-5def-950e-9de3576f9c45",
              "name": "api_url",
              "value": "https://riego.tu-dominio.pe",
              "type": "string"
            },
            {
              "id": "2b3206ad-0933-5673-861d-315ecb97fba2",
              "name": "chat_ids_campo",
              "value": "ID_CHAT_ENCARGADO,ID_CHAT_SUBGERENTE",
              "type": "string"
            },
            {
              "id": "1805cec7-be6b-5302-9c71-65a8befc87aa",
              "name": "chat_ids_sistema",
              "value": "ID_CHAT_ADMIN",
              "type": "string"
            },
            {
              "id": "ac1e7a16-18fb-50ac-bed8-e0cce0959ff2",
              "name": "chat_ids_cronogramas",
              "value": "ID_CHAT_ENCARGADO,ID_CHAT_SUBGERENTE,ID_CHAT_PROGRAMADOR",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "be97a2e5-ed79-5d00-a348-5cb943a28d5c",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Configuración').first().json.api_url }}/api/v1/copiloto/avisos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "pendientes",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "fbb0201e-bdd3-5ce8-a142-f8b9344408aa",
      "name": "Avisos pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Token agente copiloto"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Un mensaje por aviso y por chat: «campo» (MDS y riego), «sistema» (ingesta de datos) y «cronogramas»\n// (generar, publicar, corregir…). Si chat_ids_sistema o chat_ids_cronogramas están vacíos, esos avisos van a\n// los de campo. Sin chats configurados no se manda ni se confirma nada.\nconst cfg = $('Configuración').first().json;\nconst lista = (ids) => String(ids || '').split(',').map((s) => s.trim()).filter(Boolean);\nconst campo = lista(cfg.chat_ids_campo);\nconst conRespaldo = (ids) => (lista(ids).length ? lista(ids) : campo);\nconst chats = { campo, sistema: conRespaldo(cfg.chat_ids_sistema), cronogramas: conRespaldo(cfg.chat_ids_cronogramas) };\nconst salida = [];\nfor (const a of $input.first().json.avisos || []) {\n  for (const chat_id of chats[a.destino] || campo) {\n    salida.push({ json: {\n      chat_id,\n      claves: [a.clave],\n      texto: `${a.icono} ${a.titulo}\n\n${a.detalle}`.slice(0, 4000),\n    } });\n  }\n}\nreturn salida;"
      },
      "id": "216061de-3d64-55e4-a00d-9edc63d3d146",
      "name": "Mensajes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "14c98a76-c8ba-54aa-b759-08b33fdb6912",
      "name": "Enviar aviso",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Bot Telegram copiloto"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.api_url }}/api/v1/copiloto/avisos/confirmar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ claves: [...new Set($('Mensajes').all().flatMap((i) => i.json.claves))] }) }}",
        "options": {}
      },
      "id": "d564908e-ba34-5f5c-8717-4e98c987d127",
      "name": "Confirmar enviados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Token agente copiloto"
        }
      },
      "executeOnce": true
    }
  ],
  "connections": {
