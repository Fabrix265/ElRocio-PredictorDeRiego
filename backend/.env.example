# Copia este archivo a backend/.env y completa los valores. backend/.env NO se versiona.
# Las variables del entorno del proceso tienen prioridad sobre este archivo.

# --- Aplicación -------------------------------------------------------------
APP_NAME=Sistema de Plan de Riego - Grupo El Rocío
# development | test | production (production exige DEBUG=false, JWT_SECRET largo,
# COOKIE_SECURE=true, COOKIE_SAMESITE=strict, FRONTEND_URL con https, CORS solo con FRONTEND_URL
# y que DATABASE_URL use el rol riego_app: si no, la API no arranca)
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
TIMEZONE=America/Lima

# --- Base de datos (PostgreSQL / Supabase, esquema "riego") -------------------
# App: rol riego_app. En Supabase, el pooler en modo transacción (puerto 6543); el usuario va
# con el ref del proyecto: postgresql://riego_app.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local: postgresql+psycopg://riego_app:<clave>@localhost:5432/riego_dev
# Si la clave tiene @ : / # u otros símbolos, van codificados en la URL (%40 %3A %2F %23).
DATABASE_URL=
# Migraciones (Alembic), configurar-rol-app y verificar-seguridad-bd: rol dueño, puerto 5432
# (el pooler en modo transacción, 6543, se rechaza para migrar). crear-admin usa DATABASE_URL.
# Supabase, conexión directa: postgresql://postgres:<clave>@db.<ref>.supabase.co:5432/postgres
# Supabase, Session pooler (redes solo IPv4):
#   postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local: postgresql+psycopg://postgres@localhost:5432/riego_dev
DATABASE_URL_MIGRACIONES=
# auto = NullPool y sin prepared statements si la URL usa el puerto 6543; null = siempre así;
# queue = pool normal (conexión directa).
DB_POOL=auto
# Contraseña que `python -m app.cli configurar-rol-app` asigna al rol riego_app (mín. 16).
RIEGO_APP_PASSWORD=

# --- Tokens y sesión ----------------------------------------------------------
# Secreto HS256 de los JWT: al menos 32 caracteres aleatorios.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=riego-el-rocio
JWT_AUDIENCE=riego-el-rocio-web
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
# Cookie del refresh token (rt). En desarrollo local sin HTTPS: COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- Web ----------------------------------------------------------------------
# URL pública del frontend (enlaces de los correos y CORS por defecto).
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos separados por coma; vacío = solo FRONTEND_URL. Solo para desarrollo (p. ej.
# http://localhost:5173,http://127.0.0.1:5173): en producción se rechaza cualquier origen distinto
# de FRONTEND_URL, y "*" nunca se acepta.
CORS_ORIGINS=
# IPs de los proxies de confianza (de donde se acepta X-Forwarded-For para tomar la IP real).
# `python -m app` las pasa a uvicorn. Detrás de un PaaS, poner la IP o red del proxy; si queda
# 127.0.0.1, todos los clientes compartirían la IP del proxy (límite por IP global).
TRUSTED_PROXIES=127.0.0.1
# HOST y PORT de `python -m app` (por defecto 0.0.0.0 y 8000) se leen solo del entorno del
# proceso, no de este archivo.

# --- Correo (SMTP) ------------------------------------------------------------
# Si SMTP_HOST está vacío, los correos se guardan como .eml en backend/var/correos/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Phytech ------------------------------------------------------------------
# Ingesta (python -m app.cli ingestar y la tarea diaria). Clave y secreto solo sirven para pedir el
# token (JWT, vive en memoria, nunca en BD ni logs). Los IDs fijan el área, el plot y el project
# de los sensores del fundo ENSUEÑO 1 (el ambiente usa PHYTECH_PROJECT_ID).
PHYTECH_API_KEY=
PHYTECH_API_SECRET=
PHYTECH_API_BASE_URL=https://us-api.phytech.com
PHYTECH_AREA_ID=12537
PHYTECH_PLOT_ID=70208
PHYTECH_PROJECT_ID=907557

# --- WeatherLink --------------------------------------------------------------
# API v2: la clave va en la query (api-key) y el secreto en X-Api-Secret; nunca se guardan ni se
# registran (los errores guardan la ruta sin query). Las unidades se convierten a °C/mm/km en
# app/integraciones/weatherlink/conversion.py.
WEATHERLINK_API_KEY=
WEATHERLINK_API_SECRET=
WEATHERLINK_API_BASE_URL=https://api.weatherlink.com/v2
WEATHERLINK_STATION_ID=28494

# --- Modelo -------------------------------------------------------------------
# Ruta relativa a la raíz del repositorio (o absoluta) y sha256 esperado del .joblib.
ML_MODEL_PATH=ml/models/plan_riego/actual/modelo_plan_riego.joblib
ML_MODEL_SHA256=

# --- Tareas programadas y cargas ---------------------------------------------
# Hora de la ingesta diaria de WeatherLink y Phytech (hora de Lima, HH:MM). Si el proceso de
# tareas arranca después de esa hora, la lanza una vez (lo ya hecho hoy no se repite). Cada 5 min
# se cierran las corridas sin latido (proceso muerto) y, pasada esta hora, se repiten las
# programadas de hoy que quedaron interrumpidas.
INGESTA_HORA=05:00
# true = el programador de tareas corre dentro de la API (solo desarrollo);
# en producción usar el proceso aparte: python -m app.jobs
SCHEDULER_ENABLED=false
UPLOAD_MAX_MB=15

# --- Pruebas ------------------------------------------------------------------
# Base para pytest (rol dueño). Por defecto: postgresql+psycopg://postgres@localhost:5432/riego_test
# TEST_DATABASE_URL=
