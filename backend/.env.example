# Copia este archivo a backend/.env y completa los valores. backend/.env NO se versiona.
# Las variables del entorno del proceso tienen prioridad sobre este archivo.

# --- Aplicación -------------------------------------------------------------
APP_NAME=Sistema de Plan de Riego - Grupo El Rocío
# development | test | production (production exige DEBUG=false, JWT_SECRET largo,
# COOKIE_SECURE=true y FRONTEND_URL con https)
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
TIMEZONE=America/Lima

# --- Base de datos (PostgreSQL / Supabase, esquema "riego") -------------------
# App: rol riego_app. En Supabase, el pooler en modo transacción (puerto 6543); el usuario va
# con el ref del proyecto: postgresql://riego_app.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local: postgresql+psycopg://riego_app:<clave>@localhost:5432/riego_dev
DATABASE_URL=
# Migraciones (Alembic) y comandos de administración: rol dueño, conexión directa (5432).
# Supabase: postgresql://postgres:<clave>@db.<ref>.supabase.co:5432/postgres
# Local: postgresql+psycopg://postgres@localhost:5432/riego_dev
DATABASE_URL_MIGRACIONES=
# auto = NullPool y sin prepared statements si la URL usa el puerto 6543; null = siempre así;
# queue = pool normal (conexión directa).
DB_POOL=auto
# Contraseña que `python -m app.cli configurar-rol-app` asigna al rol riego_app (mín. 16).
RIEGO_APP_PASSWORD=

# --- Tokens y sesión ----------------------------------------------------------
# Secreto HS256 de los JWT: al menos 32 caracteres aleatorios.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=riego-el-rocio
JWT_AUDIENCE=riego-el-rocio-web
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
# Cookie del refresh token (rt). En desarrollo local sin HTTPS: COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- Web ----------------------------------------------------------------------
# URL pública del frontend (enlaces de los correos y CORS por defecto).
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos separados por coma; vacío = solo FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# IPs de los proxies de confianza (uvicorn --forwarded-allow-ips) para tomar la IP real.
TRUSTED_PROXIES=127.0.0.1

# --- Correo (SMTP) ------------------------------------------------------------
# Si SMTP_HOST está vacío, los correos se guardan como .eml en backend/var/correos/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Phytech ------------------------------------------------------------------
PHYTECH_API_KEY=
PHYTECH_API_SECRET=
PHYTECH_API_BASE_URL=https://us-api.phytech.com
PHYTECH_AREA_ID=12537
PHYTECH_PLOT_ID=70208
PHYTECH_PROJECT_ID=907557

# --- WeatherLink --------------------------------------------------------------
WEATHERLINK_API_KEY=
WEATHERLINK_API_SECRET=
WEATHERLINK_API_BASE_URL=https://api.weatherlink.com/v2
WEATHERLINK_STATION_ID=28494

# --- Modelo -------------------------------------------------------------------
# Ruta relativa a la raíz del repositorio (o absoluta) y sha256 esperado del .joblib.
ML_MODEL_PATH=ml/models/plan_riego/actual/modelo_plan_riego.joblib
ML_MODEL_SHA256=

# --- Tareas programadas y cargas ---------------------------------------------
# Hora de la ingesta diaria (hora de Lima, HH:MM).
INGESTA_HORA=05:00
# true = el programador de tareas corre dentro de la API (solo desarrollo);
# en producción usar el proceso aparte: python -m app.jobs
SCHEDULER_ENABLED=false
UPLOAD_MAX_MB=15

# --- Pruebas ------------------------------------------------------------------
# Base para pytest (rol dueño). Por defecto: postgresql+psycopg://postgres@localhost:5432/riego_test
# TEST_DATABASE_URL=
